# ===== 构建输出 / Electron 运行时 =====
# 运行时约 222 MB，不纳入版本管理，由 scripts/build-portable.ps1 在本地准备
dist/
_out/
build/

# app/ui/ 是 app-rhine 构建产物的拷贝（约 30 MB，含字体/配乐/GLB），由构建脚本同步，
# 不入库 —— 源在 app-rhine/dist（也由 npm run build 重新生成）。
app/ui/

# ===== 依赖 =====
node_modules/
package-lock.json

# ===== 编辑器 / IDE =====
.vs/
.vscode/
.idea/
*.suo
*.user
*.swp

# ===== Windows =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ===== 临时文件 =====
*.tmp
*.temp
*.log
*.bak
*.orig
*~
~$*

# ===== 音频 / 歌词（用户素材，不入库） =====
*.mp3
*.flac
*.m4a
*.aac
*.wav
*.ogg
*.wma
*.ncm
*.lrc

# 例外：ncmdump.exe 是随包工具，需要入库
!app/ncmdump.exe

# 例外：app-rhine 是 vendored 的 RhineLabUI 底座（MIT）。它自带的配乐/音效正是
# 上面这些格式 —— 那属于**程序资源**而不是用户素材，必须入库，
# 否则构建出来的应用没有声音（这些文件曾被静默漏掉过 5 个）。
!app-rhine/public/audio/*.mp3
!app-rhine/public/audio/*.ogg
!app-rhine/public/audio/*.wav
# 底座的依赖锁文件同样要入库，保证构建可复现
!app-rhine/package-lock.json

# ===== 下载缓存 =====
*.zip
*.7z
*.rar

# ===== 系统 =====
.DS_Store

# ===== WorkBuddy 会话数据（本机会话记录 / 项目记忆，约 39 MB） =====
# 只在本机有意义，且含本机路径与操作轨迹，不入库。
.workbuddy/

# ===== 设计素材（约 43 MB，仅本机留档） =====
# 图标导出的成品图与 .miora 设计工程、以及各版本的临时备份，
# 都不属于源码/文档，仓库保持轻量。已从仓库里的「设计参考-图A/B」
# 是例外：那两张是视觉规范基准，早就随包入库，保持不动。
设计稿-图标/
播放器图标设计_assets/
播放器图标设计.miora
备份/
